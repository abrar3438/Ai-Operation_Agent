# Copy to .env for local development. Never commit .env or real credentials.
# All values here are disposable local-development defaults or placeholders.
# Local stack: API host 8001, Postgres host 5433, web 3000, Redis 6379, pgAdmin 5050.
# Enterprise RAG already uses host 8000 and 5432; do not reuse them here.

# Application
APP_ENV=development
APP_NAME=AI Operations Agent
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Host port mapping for the API service container (container port stays 8000).
API_HOST_PORT=8001
WEB_PORT=3000
WEB_HOST_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Model provider — server-side only. Never use NEXT_PUBLIC_ prefixes or send keys to the client.
# CraftX exposes an OpenAI-compatible chat endpoint. Store its real key in .env,
# never in this file. Treat LLM_BASE_URL as the full base URL (no hardcoding).
CRAFTX_ENDPOINT=https://api.craftx.corecraftsolutions.com/api/v1/chat/completions
CRAFTX_MODEL=gpt oss 120b
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.craftx.corecraftsolutions.com/api/v1
LLM_MODEL=gpt oss 120b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0

# Agent safety budgets
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_INPUT_CHARS=8000
AGENT_MAX_OUTPUT_CHARS=12000
AGENT_MAX_TOOL_RESULTS=20
AGENT_MAX_MESSAGE_CHARS=2000
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RETRIES=2

# PostgreSQL — disposable local development only (user chose postgres/postgres/agentdb).
# The API container connects over the Compose network to host "postgres" on 5432.
# A host process (Windows) connects to localhost:5433 instead.
POSTGRES_DB=agentdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/agentdb
# Host-machine equivalent (psql, local scripts): uncomment in your own .env.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/agentdb

# pgAdmin — local development only; never expose publicly.
# PGADMIN_DEFAULT_EMAIL must be a deliverable-looking address (the container validates it).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_local_pgadmin_password
PGADMIN_HOST_PORT=5050

# Redis — local development only
REDIS_URL=redis://redis:6379/0
REDIS_HOST_PORT=6379
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_ENABLED=true

# CORS / deployment safety
# Use exact local frontend origin(s); do not use wildcard credentialed CORS.
CORS_ORIGINS=http://localhost:3000
# Public deployment must not enable write-capable demo endpoints without access control.
DEMO_MODE=true
ENABLE_MOCK_ACTIONS=true
ENABLE_LIVE_TICKET_INTEGRATION=false
ENABLE_LIVE_REPORT_DELIVERY=false

# Optional tracing integration (disabled unless separately implemented/configured)
TRACING_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-operations-agent-local
